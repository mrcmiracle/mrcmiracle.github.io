# Copy these names into Vercel → Settings → Environment Variables.
# Never commit real values; this file is only a list of the names.

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase → Project Settings → API → anon / publishable key.
# PUBLIC by design: it is what every Supabase browser app ships, and /api/config
# serves it to visitors. It can do nothing on its own here, because events has
# row level security on with no policies and progress restricts every row to its
# own signed-in user. Optional sign-in stays dark until this is set.
# Do NOT put the service_role key here - that one bypasses row level security.
SUPABASE_ANON_KEY=

# Supabase → Project Settings → API → service_role (SECRET).
# This key bypasses row level security. It must ONLY ever live in Vercel's
# environment variables — never in the page, never in this repo.
SUPABASE_SERVICE_ROLE_KEY=

# Optional Google Sheets mirror: the Apps Script /exec URL.
# Leave blank to turn the mirror off.
SHEETS_WEBHOOK_URL=
