# Copy these names into Vercel → Settings → Environment Variables.
# Never commit real values; this file is only a list of the names.

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase → Project Settings → API → anon / publishable key.
# PUBLIC by design: it is what every Supabase browser app ships, and /api/config
# serves it to visitors. It can do nothing on its own here, because events has
# row level security on with no policies and progress restricts every row to its
# own signed-in user. Optional sign-in stays dark until this is set.
# Do NOT put the service_role key here - that one bypasses row level security.
SUPABASE_ANON_KEY=

# Supabase → Project Settings → API → service_role (SECRET).
# This key bypasses row level security. It must ONLY ever live in Vercel's
# environment variables — never in the page, never in this repo.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails allowed to edit cleaner air sites at /admin.html.
# Checked on the server against the address Supabase reports for the caller's
# access token, so it cannot be bypassed from a browser. If this is unset the
# admin endpoint refuses everything - it fails closed, never open.
ADMIN_EMAILS=northcreek.mrc@gmail.com

# Google Sheets mirror: the Apps Script /exec URL. Anonymous usage is copied
# here so the team can read it in a spreadsheet. Leave blank to turn it off.
# The mirror is a copy, never the record: Supabase is the store of record, and
# a mirror failure must never lose the primary write.
SHEETS_WEBHOOK_URL=

# Origin of the deployed wound classifier, e.g. https://wound-analyzer.vercel.app
# The /predict path is added by api/wound.js. Leave blank and the wound page
# says it is not switched on yet - everything else on that page still works.
WOUND_API_URL=
