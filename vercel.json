{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|svg|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/smoke.html",
      "destination": "/emergencies.html#smoke",
      "permanent": true
    },
    {
      "source": "/earthquake.html",
      "destination": "/emergencies.html#earthquake",
      "permanent": true
    },
    {
      "source": "/kit.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/q/:slug",
      "destination": "/api/q?slug=:slug"
    },
    {
      "source": "/logo-placement-draft",
      "destination": "/logo-placement-draft.html"
    },
    {
      "source": "/logo",
      "destination": "/logo-placement-draft.html"
    }
  ]
}
